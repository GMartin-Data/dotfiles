[user]
	name = Greg Martin
	email = gregory.martin.data@gmail.com
	signingkey = CB867C69E9232B94
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[alias]
	# History without the progress.md checkpoints (one commit per checkpoint)
	lg = log --oneline --invert-grep --grep=^docs(progress)
